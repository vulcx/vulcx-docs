{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "palm",
  "name": "Vulcx",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "metadata": {
    "timestamp": true
  },
  "seo": {
    "indexing": "navigable",
    "metatags": {
      "og:type": "website",
      "og:site_name": "Vulcx",
      "og:locale": "en_US",
      "og:image": "/images/og-card.png",
      "twitter:card": "summary_large_image",
      "twitter:image": "/images/og-card.png"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "cursor"
    ]
  },
  "colors": {
    "primary": "#F47026",
    "light": "#FD944C",
    "dark": "#B03118"
  },
  "appearance": {
    "default": "dark",
    "strict": true
  },
  "background": {
    "color": {
      "dark": "#08080a",
      "light": "#ffffff"
    },
    "decoration": "grid"
  },
  "fonts": {
    "heading": {
      "family": "Bricolage Grotesque",
      "weight": 700
    },
    "body": {
      "family": "Inter",
      "weight": 400
    }
  },
  "styling": {
    "codeblocks": {
      "theme": "github-dark"
    }
  },
  "favicon": "/favicon-vx.png",
  "openapi": [
    "/api-reference/openapi.json"
  ],
  "api": {
    "asyncapi": "/api-reference/asyncapi.json",
    "playground": {
      "proxy": false
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Get Started",
        "groups": [
          {
            "group": "Get Started",
            "pages": [
              "get-started/introduction",
              "get-started/authentication",
              "get-started/architecture",
              "get-started/faq"
            ]
          }
        ]
      },
      {
        "tab": "Docs",
        "groups": [
          {
            "group": "Swap",
            "pages": [
              "docs/swap/overview",
              "docs/swap/get-quote",
              "docs/swap/firm-quotes",
              "docs/swap/build-transaction",
              "docs/swap/get-instructions",
              "docs/swap/stream-quotes",
              "docs/swap/send-transaction"
            ]
          },
          {
            "group": "Concepts",
            "pages": [
              "concepts/chains",
              "concepts/routing",
              "concepts/fees",
              "concepts/security"
            ]
          }
        ]
      },
      {
        "tab": "SDK",
        "groups": [
          {
            "group": "SDK",
            "pages": [
              "sdk/quickstart",
              "sdk/configuration",
              "sdk/quote",
              "sdk/swap",
              "sdk/instructions",
              "sdk/error-handling",
              "sdk/types",
              "sdk/examples"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "api-reference/introduction",
              "api-reference/rate-limits",
              "api-reference/errors"
            ]
          },
          {
            "group": "Endpoints",
            "pages": [
              "api-reference/quote/index",
              "api-reference/swap/index",
              "api-reference/instructions/index",
              "api-reference/cpi-route-accounts/index",
              "api-reference/stream/index",
              "api-reference/price/index",
              "api-reference/health/index"
            ]
          }
        ]
      },
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Guides",
            "pages": [
              "guides/executing-swaps",
              "guides/onchain-cpi",
              "guides/handling-errors",
              "guides/embedding-swap"
            ]
          }
        ]
      },
      {
        "tab": "AI",
        "groups": [
          {
            "group": "AI",
            "pages": [
              "ai/overview"
            ]
          }
        ]
      },
      {
        "tab": "Updates",
        "groups": [
          {
            "group": "Updates",
            "pages": [
              "updates/index"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Support",
          "href": "https://t.me/vulcxsupport",
          "icon": "telegram"
        }
      ]
    }
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Get API key",
      "href": "https://t.me/vulcxsupport"
    }
  },
  "footer": {
    "socials": {
      "x": "https://x.com/vulcx_xyz",
      "github": "https://github.com/vulcx",
      "telegram": "https://t.me/vulcxsupport"
    }
  },
  "description": "Swap aggregator API for SVM chains. Best-price multi-hop routing, firm quotes, and on-chain CPI composability. Live on Fogo, Solana support in progress."
}
